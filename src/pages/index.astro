---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panji Pangestu">
  <main class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-5xl font-bold mb-4">Panji Pangestu</h1>
    <p class="text-2xl text-gray-600 mb-6">Food Technologist & Digital Builder</p>
    <p class="max-w-2xl text-lg leading-relaxed mb-8">
      Saya bekerja di persimpangan antara <strong>ilmu pangan</strong> dan <strong>teknologi</strong>. 
      Dari memimpin produksi es krim dan riset fermentasi probiotik, hingga merancang sistem ERP dan desain visual. 
    </p>
    <a href="/about" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
      Baca Tentang Saya
    </a>
  </main>
</Layout>
